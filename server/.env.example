# ==========================================
# CONFIGURATION SERVEUR & BASE DE DONNÉES
# ==========================================
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ecole
JWT_SECRET=super_secret_jwt_key_ecole_2026_change_in_production

# ==========================================
# PARAMÈTRES SCOLAIRES & FINANCES
# ==========================================
ANNEE_SCOLAIRE=2026-2027
FRAIS_SCOLARITE=1200
FRAIS_INSCRIPTION=150

# ==========================================
# COMPTE ADMINISTRATEUR INITIAL
# ==========================================
ADMIN_EMAIL=admin@ecole.tn
ADMIN_PASSWORD=Admin123!

# ==========================================
# NOTIFICATIONS EMAIL (SendGrid / SMTP)
# (Optionnel - si vide, les emails sont simulés dans les logs)
# ==========================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM="École Primaire d'Excellence" <contact@ecole.tn>

# ==========================================
# STOCKAGE DES FICHIERS & DEVOIRS
# ==========================================
UPLOAD_DIR=./uploads
