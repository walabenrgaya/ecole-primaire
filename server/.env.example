# Copier ce fichier en server/.env (développement) ou définir ces variables sur l'hébergeur.
PORT=5000
NODE_ENV=development

# PostgreSQL (Render / Railway fournissent DATABASE_URL automatiquement)
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/ecole

# Secret de signature des sessions : OBLIGATOIRE en production (chaîne longue et aléatoire)
JWT_SECRET=

ANNEE_SCOLAIRE=2026-2027

# URL publique (utilisée dans les liens des messages : reçus PDF, etc.)
PUBLIC_URL=http://localhost:5173

# Origines autorisées pour l'API si le frontend est hébergé ailleurs (séparées par des virgules)
CORS_ORIGINS=

# E-mails (SendGrid : SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=<clé API>)
# Sans configuration, les e-mails sont simulés et tracés dans le journal des envois.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EduPilot <no-reply@edupilot.tn>

# Relances automatiques quotidiennes des impayés (true/false)
AUTO_RELANCES=true

UPLOAD_DIR=./uploads
